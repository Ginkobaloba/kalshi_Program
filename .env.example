# Copy this to .env and fill in your values. Do NOT commit .env.

# ---- Kalshi ----
# Create an API key at https://kalshi.com/settings/api-keys
# Save the downloaded private key as kalshi_private.pem in the repo root
KALSHI_API_KEY_ID=paste-your-key-id-here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private.pem

# Use 'demo' for sandbox, 'prod' for real money. Paper mode ignores this.
KALSHI_ENV=demo

# ---- External signal sources ----
# Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-key-here

# Optional: https://www.ncdc.noaa.gov/cdo-web/token
# Leave empty to use free NWS endpoints only
NOAA_TOKEN=

# ---- Polymarket (reference pricing only for now) ----
# Trading is disabled by compliance flag in config.yaml
# Public CLOB reads need no auth. If you later connect a wallet, fill these:
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ---- Polymarket US (QCX) ----
# Fill when you have an invite
POLYMARKET_US_API_KEY=
POLYMARKET_US_API_SECRET=

# ---- Runtime ----
LOG_LEVEL=INFO
